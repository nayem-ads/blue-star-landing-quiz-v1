# Railway sets PORT automatically. Do not set it there.
PORT=3000

# Railway Postgres: add the Postgres service, then in this service's Variables
# set DATABASE_URL to the reference ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Who gets the lead alert emails (comma separated)
NOTIFY_TO=nayem.adsmanager@gmail.com,mike@bluestaradjusters.com

# Option A (recommended): Resend. Sign up at resend.com with nayem.adsmanager@gmail.com,
# create an API key and paste it here. Works right away when the alert goes to your own sign up email.
RESEND_API_KEY=
# Optional once you verify a domain in Resend, e.g. Blue Star Leads <leads@bluestaradjusters.com>
EMAIL_FROM=

# Option B (no account): leave RESEND_API_KEY empty. FormSubmit sends the alerts.
# The very first lead triggers an "Activate form" email to NOTIFY_TO. Click it once.
# Your live page address, used by FormSubmit:
PUBLIC_URL=https://your-app.up.railway.app

# Download all leads as CSV: https://your-domain/admin/leads.csv?key=THIS_VALUE
ADMIN_KEY=change-me-to-a-long-random-string

# Optional Google Tag Manager container (fires Google Ads and Meta tags), e.g. GTM-ABC1234
GTM_ID=

# Paid landing pages stay out of Google search by default. Set to true to allow indexing.
ALLOW_INDEX=false

# Meta Conversions API (server Lead event, deduped with the browser pixel by lead id)
META_CAPI_TOKEN=
# Set only while testing; events then show in Events Manager > Test events. Remove to go live.
META_TEST_EVENT_CODE=

# HubSpot private app token. Run once first: node scripts/hubspot-setup.js
HUBSPOT_TOKEN=

# Page B split at /. Percent of new visitors sent to Page B (sticky cookie bs_lp). 0 turns Page B off. ?lp=a or ?lp=b forces one.
LP_SPLIT_B=50

# Page B uploads (Railway bucket, referenced from the bucket's variables). Run once after setting: railway run node scripts/bucket-cors.js
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only if the bucket's Credentials tab says path style:
# S3_PATH_STYLE=true
